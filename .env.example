# Copy this file to ".env" in the project ROOT (same folder as package.json /
# next.config.js) — NOT inside /prisma. Both the Prisma CLI (generate,
# migrate, db seed) and the Next.js server (dev/start) read the root ".env"
# file. If you instead create "prisma/.env", the Prisma CLI may pick that one
# up while `next dev` keeps reading (or missing) the root file — the two then
# disagree on where the SQLite database is, and the app fails to
# read/write users even though `prisma db seed` succeeded moments earlier.
#
# Keep this single file as the one source of truth for DATABASE_URL.

# Relative to the `prisma/` folder (Prisma always resolves sqlite "file:"
# paths relative to schema.prisma, regardless of which process read the
# env var) — this creates/uses prisma/dev.db.
DATABASE_URL="file:./dev.db"
